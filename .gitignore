# --- Terraform Runtime Directories ---
.terraform/
.terraform.lock.hcl

# --- Terraform State Files ---
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# --- Crash Logs ---
crash.log
crash.*.log

# --- Sensitive Variable Files ---
