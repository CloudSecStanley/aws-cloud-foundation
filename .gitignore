*.tfvars
*.tfvars.json

# --- Override Files ---
*.tfoverride
*.tfoverride.json
*_override.tf
*_override.tf.json

# --- CLI Configuration ---
.terraformrc
terraform.rc

# --- Linux System & IDE Files ---
.DS_Store
.vscode/
.history/
*.log